{
  "name": "@twitterapi_io/ai-sdk",
  "version": "0.1.0",
  "description": "Read-only X (Twitter) data tools for the Vercel AI SDK: tweet search, profiles, timelines, mentions, threads and trends via TwitterAPI.io",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/tools.test.mjs test/live.test.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "twitter",
    "x",
    "tweets",
    "agents",
    "twitterapi.io"
  ],
  "author": "TwitterAPI.io <hello@twitterapi.io>",
  "license": "MIT",
  "homepage": "https://twitterapi.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaitoInfra/twitterapi-io-ai-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/kaitoInfra/twitterapi-io-ai-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "ai": ">=5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ai": "^7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "zod": "^4.0.0"
  }
}
